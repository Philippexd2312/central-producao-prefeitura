generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DemandStatus {
  NEW
  AI_TRIAGE
  BRIEFING_READY
  WAITING_ASSIGNEE
  IN_PRODUCTION
  INTERNAL_REVIEW
  WAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  DELIVERED
  ARCHIVED
}

enum DemandPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DemandType {
  DESIGN
  VIDEO
  PHOTO
  COPY
  SOCIAL
  OTHER
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOGO
  REFERENCE
  PREVIEW
  FINAL
  OTHER
}

enum UserRole {
  ADMIN
  MANAGER
  DESIGNER
  EDITOR
  COPYWRITER
  SOCIAL_MEDIA
  REQUESTER
}

enum UserAvailability {
  AVAILABLE
  BUSY
  AWAY
}

enum CalendarEventType {
  COMMEMORATIVE
  BIRTHDAY
  INSTITUTIONAL
  CAMPAIGN
  OTHER
}

model Department {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  demands        Demand[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  role              UserRole
  active            Boolean          @default(true)
  availability      UserAvailability @default(AVAILABLE)
  passwordHash      String?
  lastLoginAt       DateTime?
  assignedDemands   Demand[]         @relation("DemandAssignee")
  demandMemberships DemandMember[]
  submittedVersions DemandVersion[]
  comments          DemandComment[]
  histories         DemandHistory[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Demand {
  id              String          @id @default(cuid())
  protocol        String          @unique
  title           String
  originalText    String?
  briefing        String?
  revisedText     String?
  missingInfo     String?
  type            DemandType      @default(DESIGN)
  status          DemandStatus    @default(NEW)
  priority        DemandPriority  @default(NORMAL)
  startAt         DateTime?
  dueAt           DateTime?
  approvedAt      DateTime?
  deliveredAt     DateTime?
  deliveryNote    String?
  coverUrl        String?
  requesterName   String?
  requesterPhone  String?
  source           String          @default("WEB")
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  assigneeId      String?
  assignee        User?            @relation("DemandAssignee", fields: [assigneeId], references: [id])
  members         DemandMember[]
  labels          DemandLabel[]
  checklistItems  DemandChecklistItem[]
  versions        DemandVersion[]
  assets          DemandAsset[]
  comments        DemandComment[]
  history         DemandHistory[]
  messages        DemandMessage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([dueAt])
}

model DemandMember {
  demandId String
  userId   String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([demandId, userId])
  @@index([userId])
}

model DemandLabel {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  @@index([demandId])
}

model DemandChecklistItem {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandId])
}

model DemandVersion {
  id            String   @id @default(cuid())
  demandId      String
  demand        Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  number        Int
  name          String
  url           String
  mimeType      String?
  note          String?
  final         Boolean  @default(false)
  submittedById String?
  submittedBy   User?    @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([demandId, number])
  @@index([demandId])
  @@index([submittedById])
}

model DemandAsset {
  id        String    @id @default(cuid())
  demandId  String
  demand    Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  name      String
  url       String
  mimeType  String?
  kind      AssetKind @default(OTHER)
  createdAt DateTime  @default(now())
}

model DemandComment {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

model DemandHistory {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

model DemandMessage {
  id          String   @id @default(cuid())
  demandId    String?
  demand      Demand?  @relation(fields: [demandId], references: [id], onDelete: SetNull)
  externalId  String?  @unique
  fromPhone   String?
  type        String
  text        String?
  mediaId     String?
  rawJson     Json?
  createdAt   DateTime @default(now())
}

model CalendarEvent {
  id           String            @id @default(cuid())
  title        String
  description  String?
  type         CalendarEventType @default(COMMEMORATIVE)
  eventDate    DateTime
  annual       Boolean           @default(true)
  leadDays     Int               @default(3)
  active       Boolean           @default(true)
  personName   String?
  personRole   String?
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([eventDate])
  @@index([type])
  @@index([departmentId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
